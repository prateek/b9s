+package flock
+
+import "errors"
+
+var errBrowserLock = errors.New("browser probe: cross-process flock unavailable")
+
+func (*Flock) Lock() error             { return errBrowserLock }
+func (*Flock) RLock() error            { return errBrowserLock }
+func (*Flock) TryLock() (bool, error)  { return false, errBrowserLock }
+func (*Flock) TryRLock() (bool, error) { return false, errBrowserLock }
+func (*Flock) Unlock() error           { return errBrowserLock }
