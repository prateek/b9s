+package cwriter
+
+import (
+	"bytes"
+	"io"
+)
+
+type Writer struct {
+	*bytes.Buffer
+	out      io.Writer
+	ew       escWriter
+	fd       int
+	terminal bool
+	termSize func(int) (int, int, error)
+}
+
+func (w *Writer) Flush(int) error   { _, err := w.WriteTo(w.out); return err }
+func GetSize(int) (int, int, error) { return -1, -1, ErrNotTTY }
+func IsTerminal(int) bool           { return false }
